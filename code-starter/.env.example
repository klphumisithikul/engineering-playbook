# Copy to .env and fill in real values locally. Never commit the real .env
# (it's already in .gitignore). See naming-conventions/infrastructure-resources.md
# for the UPPER_SNAKE_CASE naming convention used below.

# --- App ---
APP_ENV=development          # development | staging | production
APP_PORT=3000

# --- Database (example) ---
DATABASE_URL=postgres://user:password@localhost:5432/app_dev

# --- Third-party services (example) ---
API_KEY=
API_BASE_URL=https://api.example.com

# --- Secrets (example) ---
# In staging/production, inject these via your secrets manager/CI variables,
# not a committed file — see governance/security-practices.md.
JWT_SECRET=

